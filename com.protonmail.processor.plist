<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.protonmail.processor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/mz/_CODING/autonomous_agents_mds/scripts/process_proton_mail.py</string>
    </array>
